# Nunca compartilhe .env. As credenciais ficam apenas no servidor local.
PORT=4141
TIMEZONE=America/Sao_Paulo
CRON_SCHEDULE=0 7 * * *
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
# Chave com permissão de leitura e escrita apenas na biblioteca desejada.
ZOTERO_API_KEY=
ZOTERO_LIBRARY_TYPE=users
ZOTERO_LIBRARY_ID=
# Coleção existente opcional; chave de 8 caracteres, não o nome.
ZOTERO_COLLECTION_KEY=
